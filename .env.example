# ==============================================================================
# AgriSetu Environment Configuration Template
# Copy this file to .env and configure your local environment values.
# NEVER commit real credentials to GitHub.
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Microsoft SQL Server Database Configuration
# Option A: Windows Integrated Authentication (Default for local SQLEXPRESS)
DB_URL=jdbc:sqlserver://localhost\\SQLEXPRESS;databaseName=AgriSetuDB;integratedSecurity=true;encrypt=true;trustServerCertificate=true;
DB_USERNAME=
DB_PASSWORD=

# Option B: SQL Server Authentication (If mixed mode is enabled with a dedicated login)
# DB_URL=jdbc:sqlserver://localhost\\SQLEXPRESS;databaseName=AgriSetuDB;encrypt=true;trustServerCertificate=true;
# DB_USERNAME=agrisetu_user
# DB_PASSWORD=YourSecurePassword@2026

# Spring Security & Session Configuration
SESSION_TIMEOUT=7d
COOKIE_SECURE=false

# Default Admin Setup (Created on first run by DataInitializer if not present)
INITIAL_ADMIN_EMAIL=admin@agrisetu.org
INITIAL_ADMIN_PASSWORD=Admin@123
